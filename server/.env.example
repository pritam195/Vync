NODE_ENV=development
PORT=5000

# Comma-separated origins are supported, for example:
# CLIENT_URL=http://localhost:5173,https://vync.example.com
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/vync
REDIS_URL=redis://localhost:6379

# Use a long random value in every non-test environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Upload storage
# Use "s3" outside local development. Set LOCAL_UPLOADS_ENABLED=true only for dev fallback.
STORAGE_PROVIDER=s3
LOCAL_UPLOADS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_BUCKET=vync-uploads
# Optional CDN or S3 website/custom domain base URL. If omitted, Vync uses the standard S3 object URL.
AWS_S3_PUBLIC_BASE_URL=https://vync-uploads.s3.us-east-1.amazonaws.com

# mediasoup SFU configuration
# In production, set MEDIASOUP_ANNOUNCED_IP to your server's public IPv4 address.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_LOG_LEVEL=warn
