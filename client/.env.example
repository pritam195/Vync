# API base used by Axios. In Docker/Nginx builds this can be /api.
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL. In Docker/Nginx builds this is usually the frontend origin.
VITE_SOCKET_URL=http://localhost:5000

# Comma-separated STUN/TURN URLs are supported.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=turn:your-domain.com:3478
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password
