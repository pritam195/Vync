# Copy this file to .env before running docker compose, or keep these values as a reference.

# Client build-time configuration
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5173
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=turn:localhost:3478
VITE_TURN_USERNAME=vync
VITE_TURN_CREDENTIAL=vync-turn-password

# Server runtime configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/vync
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Local Docker fallback uploads. Use S3 for real production deployments.
STORAGE_PROVIDER=local
LOCAL_UPLOADS_ENABLED=true

# AWS S3 placeholders
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_BUCKET=vync-uploads
AWS_S3_PUBLIC_BASE_URL=https://vync-uploads.s3.us-east-1.amazonaws.com

# coturn local testing. For real deployments, use the public TURN host/IP and strong credentials.
TURN_REALM=localhost
TURN_USERNAME=vync
TURN_PASSWORD=vync-turn-password
TURN_EXTERNAL_IP=127.0.0.1

# mediasoup SFU configuration
# For Docker, set MEDIASOUP_ANNOUNCED_IP to 127.0.0.1 for local host testing, or your cloud public IP for production.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
